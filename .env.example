# CloudLabManager Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Required (for full mode) ---

# Cloudflare API token with DNS edit permissions
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Ansible vault password for decrypting secrets.yml
VAULT_PASSWORD=your_vault_password_here

# --- Optional ---

# Local test mode — set to "true" to skip all Cloudflare/DNS operations.
# Vultr instances will still be provisioned normally, but no DNS records
# will be created. Useful for testing without valid Cloudflare credentials.
# LOCAL_MODE=true

# --- Email (Sendamatic.net) ---
# Required for user invite and password reset emails.
# Format: {credential-user}-{credential-pass}
# SENDAMATIC_API_KEY=
# SENDAMATIC_SENDER_EMAIL=noreply@yourdomain.com
# SENDAMATIC_SENDER_NAME=CloudLab Manager

# --- CORS ---
# Comma-separated allowed origins. Default: * (all origins)
# ALLOWED_ORIGINS=https://yourdomain.com

# --- OIDC / SSO (external identity provider, e.g. Authentik) ---
# In production these are written automatically by
# services/authentik/configure.yaml into inputs/oidc.env. Set them here only
# for local development against a reachable OIDC provider.
# OIDC_ENABLED=true
# OIDC_ISSUER=https://auth.yourdomain.com/application/o/cloudlabmanager/
# OIDC_CLIENT_ID=cloudlabmanager
# OIDC_CLIENT_SECRET=your_client_secret_here
# OIDC_REDIRECT_URI=https://clm.yourdomain.com/api/auth/oidc/callback
# OIDC_DEFAULT_ROLE=member
# OIDC_PROVIDER_NAME=Authentik
